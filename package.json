{
  "name": "ozon-customer-mcp",
  "version": "1.4.1",
  "description": "MCP server for Ozon customer marketplace: search, product data, sellers, catalogs and delivery city via Camoufox",
  "type": "module",
  "bin": {
    "ozon-customer-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test:locations": "python test/locations.test.py",
    "test:filters": "node scripts/test-filters.js",
    "smoke": "node scripts/smoke-test.js",
    "smoke:location": "node scripts/smoke-location.js",
    "smoke:filters": "node scripts/smoke-compare-filters.js"
  },
  "keywords": ["mcp", "ozon", "marketplace", "camoufox", "customer"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.25.0"
  }
}
